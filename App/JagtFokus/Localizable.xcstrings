    "Schweiss-registret" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Schweiss register"
          }
        }
      }
    },
    "Schweiss-registret er frivillige hundeførere med specialtrænede hunde. De er legitimeret af Naturstyrelsen og må eftersøge og aflive nødstedt vildt på anden mands grund. Du betaler kun kørsel." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Schweiss register is volunteer handlers with specially trained dogs. They are authorised by the Danish Nature Agency and may track and put down wounded game on another person's land. You pay for travel only."
          }
        }
      }
    },
