            "value" : "Your location stays on your phone"
          }
        }
      }
    },
    "Er der tegn på anskydning af hjortevildt, og dyret ikke er fundet, skal du senest efter seks dagtimer tilkalde en hundefører fra Schweiss-registret." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there are signs that deer has been wounded and the animal has not been found, you must call a handler from the Schweiss register no later than six daylight hours afterwards."
          }
        }
      }
    },
