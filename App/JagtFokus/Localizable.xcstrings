    "Ring 93 59 70 80, Schweiss-sekretariatet" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call 93 59 70 80, the Schweiss secretariat"
          }
        }
      }
    },
    "Ring, hvis dyret ikke er dødt. Vagtcentralen kontakter en schweisshundefører, hvis det er løbet væk. Afmærk stedet tydeligt i rabatten, og oplys sted, hændelse og flugtretning." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call if the animal is not dead. The emergency line contacts a Schweiss handler if it has run off. Mark the spot clearly in the verge, and say where, what happened and which way it ran."
          }
        }
      }
    },
