    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "The system's own prompt for location. Set in the target's build settings.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "JagtFokus bruger din position til at vise jagttider, sol og vejr for det sted, du er, og hvor du står på kortet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JagtFokus uses your location to show hunting seasons, sun and weather for where you are, and where you stand on the map."
          }
        }
      }
    },
    "Skel" : {
      "comment" : "Purpose key for temporary full accuracy. Asked from the map tab when precise location is off.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Præcis position viser, hvilken side af skellet du står på."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precise location shows which side of the boundary you are on."
          }
        }
      }
    }
  },
  "version" : "1.0"
