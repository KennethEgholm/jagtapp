<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Danish is the source language, so it has no .lproj folder of its own.
	     Listing both keeps the App Store and the per-app language picker honest. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>da</string>
		<string>en</string>
	</array>
	<key>DatafordelerApiKey</key>
	<string>$(DATAFORDELER_API_KEY)</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>Skel</key>
		<string>Præcis position viser, hvilken side af skellet du står på.</string>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
